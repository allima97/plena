{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "plena-backup-cron",
    "main": "src/index.js",
    "compatibility_date": "2026-09-07",
    // D1 — mesmo banco de dados do Plena (só leitura neste Worker)
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "plena-db",
            "database_id": "0df2c54b-70ce-43ab-a04b-7816876d0d5b"
        }
    ],
    // R2 — bucket de backups (criar com: npx wrangler r2 bucket create plena-backups)
    "r2_buckets": [
        {
            "binding": "BACKUPS",
            "bucket_name": "plena-backups"
        }
    ],
    // Cron: todo dia às 06:00 UTC (03:00 BRT)
    "triggers": {
        "crons": ["0 6 * * *"]
    }
}
