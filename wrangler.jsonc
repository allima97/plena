{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plena",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "plena-db",
			"database_id": "0df2c54b-70ce-43ab-a04b-7816876d0d5b"
		}
	],
	// Cloudflare Access (Zero Trust) -- login com Google na frente do site
	// inteiro. Nenhum dos dois valores é secreto (POLICY_AUD é só o
	// identificador público da Application no Access), por isso ficam aqui
	// em "vars" e não como secret. Mesmos valores do nextgoals -- a mesma
	// Application do Access cobre os dois domínios (veja README.md, seção
	// "Login com Google", se precisar recriar isso do zero um dia).
	"vars": {
		"TEAM_DOMAIN": "https://nxapps.cloudflareaccess.com",
		"POLICY_AUD": "43f80517f57450906c918145b91b19cb560e194fca1c3b6abf2071f1f8eb2968"
	}
}
