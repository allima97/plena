{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plena",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],
	// usage_model "unbound" para planos Bundled/Unbound legados (sem limite de CPU).
	// Para o plano Workers Standard, usar "limits.cpu_ms" abaixo.
	"usage_model": "unbound",
	// Permite até 30 s de CPU por request. Necessário para PBKDF2-SHA256:
	// verifyPassword (600k hash legado) ≈ 52 ms; hashPassword (260k) ≈ 22 ms.
	"limits": { "cpu_ms": 30000 },
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"services": [{ "binding": "NEXTGOALS", "service": "nextgoals" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "plena-db",
			"database_id": "0df2c54b-70ce-43ab-a04b-7816876d0d5b",
			"migrations_dir": "migrations"
		}
	],
	// Email transacional para os códigos de login. O domínio remetente está
	// habilitado no Cloudflare Email Service.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["conta@salaonamao.com"]
		}
	],
	"vars": {
		"AUTH_EMAIL_FROM": "conta@salaonamao.com",
		"LEGACY_DATA_OWNER_EMAIL": "allima97@gmail.com",
		// URL pública do Worker do Nextgoals (sem barra final)
		// Exemplo: "https://nextgoals.nxapps.workers.dev"
		"NEXTGOALS_URL": "https://nextgoals.nxapps.com.br"
		// SYNC_SECRET: segredo compartilhado entre Plena e Nextgoals.
		// NÃO colocar aqui — usar: wrangler secret put SYNC_SECRET
		// O mesmo valor deve ser configurado nos dois Workers.
	}
}
