{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plena",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "plena-db",
			"database_id": "COLE_AQUI_O_DATABASE_ID_DEPOIS_DO_WRANGLER_D1_CREATE"
		},
		{
			"binding": "plena_db",
			"database_name": "plena-db",
			"database_id": "0df2c54b-70ce-43ab-a04b-7816876d0d5b",
			"remote": true
		}
	]
}